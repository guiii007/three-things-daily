{
  "name": "three-things-companion",
  "version": "0.4.0",
  "description": "三件事 · 像素伙伴桌面软件",
  "main": "desktop/main.js",
  "author": "three-things-daily",
  "license": "MIT",
  "scripts": {
    "start": "electron .",
    "test": "node --test desktop/test/*.test.js",
    "test:desktop": "node desktop/test/smoke.js",
    "test:interaction": "node desktop/test/interaction.js",
    "prepare:assets": "node desktop/prepare-assets.js",
    "build": "node desktop/prepare-assets.js && electron-builder --win portable --x64 --config.electronDist=node_modules/electron/dist",
    "test:library": "node desktop/test/library.js",
    "test:single": "node desktop/test/single-companion.js"
  },
  "devDependencies": {
    "@fontsource/fusion-pixel-12px-proportional-sc": "5.2.5",
    "electron": "44.7.0",
    "electron-builder": "^26.0.12"
  },
  "build": {
    "appId": "io.threethings.companion",
    "productName": "三件事像素伙伴",
    "asar": true,
    "directories": {
      "output": "dist"
    },
    "files": [
      "desktop/**/*",
      "index.html",
      "!desktop/test/**/*",
      "!desktop/prepare-assets.js"
    ],
    "win": {
      "target": "portable",
      "signAndEditExecutable": true,
      "icon": "desktop/assets/app-icon.ico",
      "signExecutable": false
    },
    "portable": {
      "artifactName": "ThreeThings-${version}-Windows.exe"
    }
  },
  "dependencies": {
    "koffi": "^3.3.3"
  }
}
